APP_NAME="Dorzak Merchant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# First-party SPA origin(s) for credentialed CORS + Sanctum stateful auth (docs 06 §1, 12 §9)
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production target is PostgreSQL 16 (docs 04 — partial unique indexes, reporting).
# SQLite in-memory is the fast PHPUnit lane; PostgreSQL 16 is the complete qualification lane.
# Every qualification invocation provisions a new empty database whose name ends _test.
# DB_URL is internal guarded-runner state; callers must not supply, print, persist or reuse it.
# P00_PG_IDENTITY, attestation hash and instance nonce are separate approved inputs.
# Provisioning rejects unsafe candidates before migration; PHPUnit bootstrap rebinds the exact live authority before tests.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dorzak_merchant
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# For subdomain cookie sharing in production set e.g. .dorzak.com
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Dorzak Business (the delivery network) ───────────────────────────────────
# Mint credentials in the dorzak-business repo:  php artisan integration:client:make "Dorzak Merchant"
# Leave DORZAK_BUSINESS_ENABLED=false to hide the Dorzak courier from checkout.
# The webhook secret must equal dorzak-business's DORZAK_INTEGRATION_OUTBOUND_SECRET,
# and its DORZAK_INTEGRATION_WEBHOOK_URL must point at /api/webhooks/dorzak-business here.
DORZAK_BUSINESS_ENABLED=false
DORZAK_BUSINESS_URL=http://127.0.0.1:8006
DORZAK_BUSINESS_CLIENT_ID=
DORZAK_BUSINESS_CLIENT_SECRET=
DORZAK_BUSINESS_WEBHOOK_SECRET=
DORZAK_BUSINESS_SOURCE_SYSTEM=dorzak-merchant
DELIVERY_ZONE_KEY=doha
DELIVERY_VEHICLE_REQUIREMENT=any
DELIVERY_COMPARATOR_TIER=bike
