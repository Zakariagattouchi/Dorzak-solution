{
  "$schema": "internal:page-backend-map",
  "generated_from": "src/ of recovered React app + docs/06-api-contract-map.md",
  "api_prefix": "/api/v1",
  "pages": [
    {
      "id": "pos",
      "route": "/checkout",
      "component": "src/pages/pos/POSPage.tsx",
      "roles": ["owner", "manager", "cashier"],
      "endpoints": [
        {"method": "GET", "path": "/products", "params": ["per_page", "active"]},
        {"method": "GET", "path": "/categories"},
        {"method": "GET", "path": "/customers", "params": ["search"]},
        {"method": "POST", "path": "/orders", "permission": "orders.create"}
