        {"method": "GET", "path": "/api/public/stores/{slug}/catalog", "auth": false, "params": ["category_id", "search"]},
        {"method": "POST", "path": "/api/public/stores/{slug}/orders", "auth": false, "rate_limited": true, "creates": "order status=PENDING method=WHATSAPP source=online", "returns": "whatsapp_url"}
