        {"method": "GET", "path": "/products", "params": ["search", "category_id", "status", "stock", "page", "per_page", "sort"]},
        {"method": "POST", "path": "/products", "permission": "products.manage"},
        {"method": "GET", "path": "/products/{product}"},
        {"method": "PUT", "path": "/products/{product}", "permission": "products.manage"},
        {"method": "DELETE", "path": "/products/{product}", "permission": "products.manage", "soft_delete": true},
        {"method": "POST", "path": "/products/{product}/image", "permission": "products.manage", "multipart": true},
        {"method": "POST", "path": "/ai/product-description", "optional": true}
