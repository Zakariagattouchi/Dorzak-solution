      "endpoints": [
        {"method": "GET", "path": "/orders", "params": ["search", "status", "date_from", "date_to", "payment_method", "page", "per_page", "sort"], "meta_summary": ["revenue", "completed_count", "pending_count", "cancelled_count", "tax_total", "discount_total"]},
        {"method": "GET", "path": "/orders/{order}"},
        {"method": "PATCH", "path": "/orders/{order}/status", "permission": "orders.update_status"},
        {"method": "GET", "path": "/orders/export", "permission": "reports.export", "format": "csv"}
      ],
      "modals": ["RECEIPT"],
      "priority_milestone": 5
    },
    {
      "id": "products",
      "route": "/products",
      "component": "src/pages/products/ProductsPage.tsx",
