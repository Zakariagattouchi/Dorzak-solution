      "modals": ["PAYMENT", "CUSTOMER_CREATE", "PRODUCT_CREATE", "RECEIPT"],
      "side_effects": ["stock deduction", "stock_movements", "customer counters", "OrderCreated event", "LowStockDetected"],
      "priority_milestone": 5
    },
    {
      "id": "orders",
      "route": "/orders",
      "component": "src/pages/orders/OrdersPage.tsx",
