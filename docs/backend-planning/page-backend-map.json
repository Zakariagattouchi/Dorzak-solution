      "endpoints": [
        {"method": "GET", "path": "/settings"},
        {"method": "PUT", "path": "/settings/general"},
        {"method": "PUT", "path": "/settings/business"},
        {"method": "PUT", "path": "/settings/currency"},
        {"method": "PUT", "path": "/settings/taxes"},
        {"method": "PUT", "path": "/settings/receipts"},
