      "endpoints": [
        {"method": "GET", "path": "/categories"},
        {"method": "POST", "path": "/categories", "permission": "products.manage"},
        {"method": "PUT", "path": "/categories/{category}", "permission": "products.manage"},
        {"method": "DELETE", "path": "/categories/{category}", "permission": "products.manage", "behavior": "null product category_id"},
        {"method": "PATCH", "path": "/categories/reorder", "assumption": true}
      ],
      "priority_milestone": 3
    },
    {
      "id": "customers",
      "route": "/customers",
      "component": "src/pages/customers/CustomersPage.tsx",
      "roles": ["owner", "manager", "cashier", "viewer:read"],
      "endpoints": [
        {"method": "GET", "path": "/customers", "params": ["search", "sort", "page", "per_page"], "meta_summary": ["count", "total_spent", "avg_ltv"]},
        {"method": "POST", "path": "/customers"},
        {"method": "GET", "path": "/customers/{customer}", "includes": ["recent_orders(3)"]},
        {"method": "PUT", "path": "/customers/{customer}"},
        {"method": "DELETE", "path": "/customers/{customer}", "soft_delete": true, "confirm_in_ui": true},
        {"method": "GET", "path": "/customers/export", "format": "csv"},
        {"method": "POST", "path": "/customers/import", "multipart": true, "queued_over": 500}
      ],
      "priority_milestone": 4
    },
    {
